<Layouts.app flash={@flash} section={:projects}>
  <.async_result :let={review} assign={@loaded}>
    <:loading>
      <div class="flex flex-1 flex-col items-center justify-center gap-3 p-8 text-xs text-base-content/45">
        <.spinner />
        <p>Loading {@review_id} in {@project.name}...</p>
      </div>
    </:loading>

    <:failed :let={failure}>
      <div class="flex flex-1 items-center justify-center p-8">
        <.alert tone="error" title="That review could not be opened" class="max-w-xl">
          <:actions>
            <.button navigate={~p"/projects/#{@slug}"} variant="ghost" size="xs">
              Back to {@project.name}
            </.button>
          </:actions>
          {async_failure_message(failure)}
        </.alert>
      </div>
    </:failed>

    <header class="flex flex-none flex-col gap-2 border-b border-base-300 px-4 py-3">
      <div class="flex flex-wrap items-center gap-2 text-xs text-base-content/55">
        <.link navigate={~p"/projects/#{@slug}"} class="font-medium hover:text-base-content">
          {@project.name}
        </.link>
        <span>/</span>
        <span class="font-mono">{@review_id}</span>
      </div>

      <div class="flex flex-wrap items-center gap-2">
        <h1 class="text-sm font-semibold tracking-tight">{review.title}</h1>
        <.badge :if={@pull && @pull.draft}>draft</.badge>
        <.badge :if={@pull} tone={if @pull.state == "open", do: "added", else: "muted"}>
          {@pull.state}
        </.badge>
      </div>

      <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-base-content/55">
        <span :if={@pull && @pull.author} class="font-mono">{@pull.author}</span>
        <span class="font-mono">{review.base_ref} ← {review.head_ref}</span>
        <span class="flex items-center gap-1.5">
          {length(review.diff.files)} files
          <.diff_stats additions={review.diff.additions} deletions={review.diff.deletions} />
        </span>
        <.external_link :if={@pull && @pull.html_url} href={@pull.html_url} class="ml-auto">
          View on GitHub
        </.external_link>
      </div>
    </header>

    <.alert :if={@comment_error} tone="error" class="mx-4 mt-4">{@comment_error}</.alert>

    <div class="flex min-h-0 flex-1">
      <aside class="flex w-80 flex-none flex-col overflow-y-auto border-r border-base-300 bg-base-200">
        <div class="flex flex-none flex-col gap-2 border-b border-base-300 px-3 py-2.5">
          <div class="flex items-center justify-between gap-2">
            <p class="text-xs text-base-content/60">
              <span class="font-medium text-base-content">
                {reviewed_count(@review_state, review.diff.files)}/{length(review.diff.files)}
              </span>
              files reviewed
            </p>
            <.diff_stats additions={review.diff.additions} deletions={review.diff.deletions} />
          </div>
          <.progress
            value={reviewed_count(@review_state, review.diff.files)}
            max={length(review.diff.files)}
          />
        </div>

        <.file_nav files={review.diff.files} review={@review_state} />
      </aside>

      <main
        id="diff"
        phx-hook="LineSelection"
        class="min-w-0 flex-1 overflow-auto"
      >
        <.empty_state
          :if={review.diff.files == []}
          icon="hero-check-circle"
          title="Nothing to review"
        >
          This diff changes nothing.
        </.empty_state>

        <.file
          :for={file <- review.diff.files}
          file={file}
          review={@review_state}
          comments={comments_for(@review_state, file.path)}
          comment_at={@comment_at}
          agent={@agent}
        />
      </main>

      <aside
        id="assistant"
        class="flex w-96 flex-none flex-col border-l border-base-300 bg-base-200"
      >
        <header class="flex flex-none items-center gap-2 border-b border-base-300 px-3 py-2.5">
          <.section_title>Assistant</.section_title>
          <div
            :if={@processing}
            class="ml-auto flex items-center gap-2 text-xs text-base-content/55"
          >
            <.spinner size="xs" />
            <span :if={@activity} class="max-w-40 truncate font-mono" title={@activity}>
              {@activity}
            </span>
            <span :if={!@activity}>Thinking...</span>
          </div>
          <.button
            :if={@processing}
            type="button"
            size="xs"
            variant="quiet"
            phx-click="cancel_turn"
          >
            Stop
          </.button>
        </header>

        <div
          id="assistant-threads"
          phx-hook="AutoScroll"
          class="flex min-h-0 flex-1 flex-col gap-3 overflow-y-auto p-3"
        >
          <p
            :if={@agent.list == [] and is_nil(@agent.streaming_entry)}
            class="text-xs leading-relaxed text-base-content/45"
          >
            Select lines in the diff — by their numbers, shift-clicking to extend a
            range — and ask about them here. With nothing selected, a question is
            about the whole review.
          </p>

          <.thread :for={thread <- @agent.list} thread={thread} />

          <div
            :if={streaming = @agent.streaming_entry}
            class="assistant-thread assistant-thread--streaming"
          >
            <p class="assistant-reply">{streaming.content}</p>
          </div>
        </div>

        <.alert
          :if={@agent_error}
          tone="error"
          class="mx-3 mb-3 max-h-48 flex-none overflow-y-auto"
        >
          <:actions>
            <.button
              :if={not @processing and asked?(@agent_state)}
              size="xs"
              variant="quiet"
              class="text-error hover:bg-error/10 hover:text-error"
              phx-click="retry_turn"
            >
              Retry
            </.button>
          </:actions>
          <span class="block whitespace-normal">
            {@agent_error}
            <span :if={credential_hint(@agent_error)} class="mt-1 block opacity-80">
              {credential_hint(@agent_error)}
            </span>
          </span>
        </.alert>

        <form
          id="ask"
          phx-submit="ask"
          class="flex flex-none flex-col gap-2 border-t border-base-300 bg-base-100 p-3"
        >
          <div :if={@agent.ask_scope} class="flex items-center gap-2">
            <p class="assistant-scope min-w-0 flex-1 truncate">
              Ask about {@agent.ask_scope}
            </p>
            <button
              type="button"
              class="flex-none text-[0.6875rem] text-base-content/45 hover:text-base-content"
              phx-click="clear_selection"
            >
              Clear
            </button>
          </div>
          <p :if={!@agent.ask_scope} class="text-[0.6875rem] text-base-content/45">
            Asking about the whole review.
          </p>

          <.input
            type="textarea"
            name="question[body]"
            rows="3"
            autocomplete="off"
            disabled={@processing}
            class="font-mono"
            placeholder="Ask the assistant about this review..."
          />

          <div class="flex items-center gap-2">
            <.button type="submit" disabled={@processing}>Ask</.button>
            <span :if={@agent.ask_scope} class="text-[0.6875rem] text-base-content/45">
              Shift-click a line's number to extend the selection.
            </span>
          </div>
        </form>
      </aside>
    </div>
  </.async_result>
</Layouts.app>
