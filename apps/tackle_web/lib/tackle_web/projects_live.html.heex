<Layouts.app flash={@flash} section={:projects}>
  <div class="min-h-0 flex-1 overflow-y-auto">
    <div class="mx-auto flex w-full max-w-3xl flex-col gap-6 px-4 py-6">
      <header class="flex flex-col gap-1">
        <h1 class="text-sm font-semibold tracking-tight">Projects</h1>
        <p class="text-xs leading-relaxed text-base-content/55">
          A project is one local git repository or one GitHub repository. Chats and reviews live
          inside a project, so the assistant always knows which code it is looking at.
        </p>
      </header>

      <.alert :if={@error} tone="error">{@error}</.alert>

      <.card>
        <form id="add-project" phx-submit="add" class="flex flex-col gap-3">
          <div class="flex flex-wrap items-end gap-3">
            <.field label="Kind" for="kind" class="w-40">
              <select id="kind" name="project[kind]" class="select select-sm w-full">
                <option :for={kind <- @kinds} value={kind}>{Project.label(kind)}</option>
              </select>
            </.field>

            <.field label="Repository" for="locator" class="min-w-0 flex-1">
              <.input
                id="locator"
                name="project[locator]"
                placeholder="/path/to/repo or owner/repo"
                autocomplete="off"
                class="font-mono"
              />
            </.field>

            <.button type="submit" phx-disable-with="Adding...">Add project</.button>
          </div>
          <p class="text-[0.6875rem] leading-relaxed text-base-content/45">
            A local path has to be a git repository this server can read. A GitHub repository is
            looked up through the API, so a private one needs a token.
          </p>
        </form>
      </.card>

      <.empty_state :if={@projects == []} icon="hero-folder-open" title="No projects yet">
        Add a local repository or a GitHub repository to start.
      </.empty_state>

      <div :if={@projects != []} class="flex flex-col gap-2">
        <div
          :for={project <- @projects}
          id={"project-#{project.slug}"}
          class="group flex items-center gap-3 rounded-xl border border-base-300 bg-base-100 px-3 py-2.5 transition-colors hover:border-primary/30"
        >
          <.link navigate={~p"/projects/#{project.slug}"} class="min-w-0 flex-1">
            <div class="flex items-center gap-2">
              <span class="truncate text-sm font-medium">{project.name}</span>
              <.badge tone={if project.kind == :github, do: "brand", else: "neutral"}>
                {Project.label(project.kind)}
              </.badge>
            </div>
            <p class="mt-0.5 truncate font-mono text-[0.6875rem] text-base-content/45">
              {project.locator}
            </p>
          </.link>

          <.icon_button
            phx-click="remove"
            phx-value-slug={project.slug}
            title={"Remove #{project.name}"}
            class="opacity-0 transition-opacity group-hover:opacity-100 focus-visible:opacity-100"
          >
            <.icon name="hero-trash-mini" class="size-4" />
          </.icon_button>
        </div>
      </div>
    </div>
  </div>
</Layouts.app>
