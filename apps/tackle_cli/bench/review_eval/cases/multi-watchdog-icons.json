      ],
      "anchor": "    Registry.lookup(@name, {:service, agent_id, scope_id, key}) |> first()",
      "description": "Registry.service/2 looks a service up under {:service, agent_id, scope_id, key}, but service_name/2 registers under scope_id first, so no named service is ever found and the CLI never marks a running call as watched.",
