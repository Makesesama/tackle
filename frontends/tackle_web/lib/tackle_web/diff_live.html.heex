<Layouts.app flash={@flash}>
  <div class="flex flex-none flex-col border-b border-base-300">
    <form
      id="pull-request"
      phx-submit="open_pull_request"
      class="flex flex-wrap items-end gap-3 px-4 py-3"
    >
      <.field label="Pull request" for="reference" class="min-w-0 flex-1">
        <.input
          id="reference"
          name="reference"
          placeholder="owner/repo#123 or https://github.com/owner/repo/pull/123"
          class="font-mono"
        />
      </.field>
      <.button type="submit" phx-disable-with="Opening...">Review pull request</.button>
    </form>

    <form
      id="local-diff"
      phx-submit="load"
      class="flex flex-wrap items-end gap-3 border-t border-base-300 bg-base-200 px-4 py-3"
    >
      <.field label="Repository" for="repo" class="min-w-0 flex-1">
        <.input id="repo" name="repo" value={@repo} placeholder="/path/to/repo" class="font-mono" />
      </.field>
      <.field label="Base" for="base" class="w-32">
        <.input id="base" name="base" value={@base} class="font-mono" />
      </.field>
      <.field label="Head" for="head" class="w-32">
        <.input id="head" name="head" value={@head} class="font-mono" />
      </.field>
      <.button type="submit" phx-disable-with="Loading...">Show diff</.button>
    </form>

    <.alert :if={@pr_error} tone="error" class="m-4">{@pr_error}</.alert>
  </div>

  <div :if={is_nil(@diff)} class="flex flex-1 items-center justify-center p-8">
    <.empty_state icon="hero-code-bracket" title="Review a local change">
      Enter the path to a local git repository, then the two refs to compare.
    </.empty_state>
  </div>

  <.async_result :let={diff} :if={@diff} assign={@diff}>
    <:loading>
      <div class="flex flex-1 items-center justify-center gap-2 text-xs text-base-content/45">
        <.spinner /> Loading diff...
      </div>
    </:loading>

    <:failed :let={failure}>
      <div class="flex flex-1 items-center justify-center p-8">
        <.alert tone="error" title="That diff could not be loaded" class="max-w-xl">
          {failure_message(failure)}
        </.alert>
      </div>
    </:failed>

    <div class="flex min-h-0 flex-1">
      <aside class="flex w-80 flex-none flex-col overflow-y-auto border-r border-base-300 bg-base-200">
        <div class="flex-none border-b border-base-300 px-3 py-2.5">
          <div class="flex items-center justify-between gap-2">
            <p class="text-xs text-base-content/60">
              <span class="font-medium text-base-content">{length(diff.files)}</span>
              files changed
            </p>
            <.diff_stats additions={diff.additions} deletions={diff.deletions} />
          </div>
          <p class="mt-1 font-mono text-[0.6875rem] text-base-content/45">
            {short_sha(diff.base_sha)}...{short_sha(diff.head_sha)}
          </p>
        </div>

        <.file_nav files={diff.files} />
      </aside>

      <main class="min-w-0 flex-1 overflow-auto">
        <.empty_state :if={diff.files == []} icon="hero-check-circle" title="No changes">
          These refs point at the same tree.
        </.empty_state>

        <.file :for={file <- diff.files} file={file} />
      </main>
    </div>
  </.async_result>
</Layouts.app>
